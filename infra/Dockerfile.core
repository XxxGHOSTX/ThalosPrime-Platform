FROM python:3.11-slim

LABEL maintainer="Tony Ray Macier III"
LABEL description="Thalos Prime Core Runtime - Hardened"
LABEL version="2.0.0"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV OWNER="Tony Ray Macier III"
ENV SEED_STRENGTH="64BIT"
ENV PYTHONPATH="/app"

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY services/ ./services/
COPY core/ ./core/
COPY system/ ./system/
COPY automation/ ./automation/
COPY pyproject.toml .

RUN mkdir -p STATELOG

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["python", "-m", "uvicorn", "services.control_plane.main:app", "--host", "0.0.0.0", "--port", "8000"]
